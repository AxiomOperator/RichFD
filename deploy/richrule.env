# richrule settings. Restart after editing: systemctl restart richrule

# Listen address and port. 127.0.0.1 = reachable only through an SSH tunnel or a local reverse
# proxy. Use 0.0.0.0 (with TLS!) to manage this host from a richrule console on another machine.
RICHRULE_HOST=127.0.0.1
RICHRULE_PORT=8443

# Linux groups: full access / read-only access.
RICHRULE_ALLOWED_GROUP=wheel
RICHRULE_VIEWER_GROUP=firewall-viewers

# Built-in HTTPS (install.sh --tls creates a self-signed certificate). Secure cookies are
# enabled automatically when TLS is on.
#RICHRULE_TLS_CERT=/etc/richrule/tls/cert.pem
#RICHRULE_TLS_KEY=/etc/richrule/tls/key.pem

# Set to 1 when behind a TLS reverse proxy (Caddy/nginx) so cookies are marked Secure.
#RICHRULE_SECURE_COOKIES=1

# Seconds between checks for firewall changes made outside richrule (0 = off).
#RICHRULE_WATCH_INTERVAL=30

# Safe-apply revert timeout and session idle timeout, in seconds.
#RICHRULE_SAFE_APPLY_SECONDS=60
#RICHRULE_SESSION_IDLE_SECONDS=1800
