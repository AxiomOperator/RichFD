[Unit]
Description=richrule - firewalld web manager
After=network.target firewalld.service
Wants=firewalld.service

[Service]
Type=simple
# Root is required to change firewalld config over D-Bus, verify passwords via PAM,
# snapshot /etc/firewalld, read the kernel log, list sockets with process names (ss -p),
# close connections (ss -K / conntrack -D) and talk to fail2ban.
User=root
WorkingDirectory=/opt/richrule/backend
Environment=RICHRULE_PAM_SERVICE=richrule
Environment=RICHRULE_STATIC_DIR=/opt/richrule/frontend/dist
# Site settings (listen address, TLS, groups, ...). Values here override the lines above.
EnvironmentFile=-/etc/richrule/richrule.env
ExecStart=/opt/richrule/backend/.venv/bin/python -m app.main
Restart=on-failure

StateDirectory=richrule
StateDirectoryMode=0700
LogsDirectory=richrule
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
# /etc/firewalld: restoring snapshots/backups writes config files.
# /etc/fail2ban: jail settings from the Fail2ban page (ignored if fail2ban is not installed).
ReadWritePaths=/etc/firewalld -/etc/fail2ban
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
